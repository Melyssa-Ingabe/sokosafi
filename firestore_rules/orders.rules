// Security rules for the orders collection.
// Owner: Prince
// Send to Nelly to merge into firestore.rules.
//
// Orders can be created by any authenticated user (the customer).
// Only the customer who placed the order can read or update it.
// Kevine's business-side reads are covered by his own rules on
// the business orders query (filtered by businessId).
//
// Paste this match block inside the top-level
// match /databases/{database}/documents { ... } in firestore.rules.

match /orders/{orderId} {
  // The customer who created the order.
  function isOwner() {
    return request.auth != null
        && resource.data.customerId == request.auth.uid;
  }

  // A signed-in user creating their own order.
  function isValidCreate() {
    let d = request.resource.data;
    return request.auth != null
        && d.customerId == request.auth.uid
        && d.keys().hasAll([
             'customerId', 'businessId', 'listingId',
             'quantity', 'total', 'pickupCode',
             'paymentMethod', 'status', 'createdAt'
           ])
        && d.quantity is int && d.quantity >= 1
        && d.total is number && d.total > 0
        && d.status == 'paid';
  }

  // Customers can only cancel their own paid orders.
  function isValidCancel() {
    return isOwner()
        && request.resource.data.status == 'cancelled'
        && resource.data.status == 'paid'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status']);
  }

  // Business owners can mark orders as collected.
  function isBusinessCollect() {
    return request.auth != null
        && request.resource.data.status == 'collected'
        && resource.data.status == 'paid'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'collectedAt']);
  }

  // Customer reads their own orders; business owner reads orders for their business.
  allow read: if isOwner()
      || (request.auth != null
          && get(/databases/$(database)/documents/businesses/$(resource.data.businessId)).data.ownerId == request.auth.uid);

  allow create: if isValidCreate();
  allow update: if isValidCancel() || isBusinessCollect();
  allow delete: if false;
}
